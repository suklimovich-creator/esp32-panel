# Настройки сборки по умолчанию. Файл sdkconfig создаётся из них при первой
# сборке; чтобы применить правку отсюда, удалите sdkconfig (или Full Clean).

CONFIG_IDF_TARGET="esp32s3"

# --- Flash 16 МБ и своя разметка ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Откат: новая версия, не подтвердившая работоспособность, откатывается
# загрузчиком на прошлую при следующем старте.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Процессор и PSRAM (8 МБ, octal) ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Код и константы исполняются из PSRAM: запись во flash (обновление)
# не останавливает вывод на матрицу.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# --- RGB-матрица ---
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
# Перезапуск передачи в начале кадра: картинка не "уезжает" при нагрузке на PSRAM.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# --- Система ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Сеть, веб-страница, обновление ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# --- LVGL 9 ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=49152
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=128
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
